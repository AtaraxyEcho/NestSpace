# =============================================================================
# NestSpace 本地开发环境变量模板（Cloudflare Workers + D1 形态）
#
# 使用方法：复制为 frontend/.dev.vars（wrangler dev 启动时自动加载）
#   cp .dev.vars.example .dev.vars
#
# 安全说明：
#   - .dev.vars 已被 .gitignore 忽略，其中的密钥只存在于你的本机；
#   - 生产环境密钥走 `npx wrangler secret put ADMIN_SECRET_KEY`，
#     非机密配置走 Workers 的 Settings ➔ Variables and Secrets，均不经过本文件；
#   - ACCESS_TEAM_NAME / ACCESS_AUD_TAG 仅用于本地联调 JWT 校验防线，
#     不配置时该防线关闭（管理接口仅认 Bearer 密钥，与生产默认一致）。
# =============================================================================

# 管理端 Bearer 密钥（本地开发用，生成方式：openssl rand -base64 32）
ADMIN_SECRET_KEY=

# Cloudflare Zero Trust 团队名（<team>.cloudflareaccess.com 中的 <team>）
# ACCESS_TEAM_NAME=

# Zero Trust Access 应用的 AUD Tag（配置后启用本地 JWT 签名校验）
# ACCESS_AUD_TAG=

# 启用 Access JWT 防线时**必填**：允许经 JWT 进入管理端的身份白名单（逗号分隔的邮箱或 sub）。
# fail-closed：不填则该防线一律拒绝（不影响 Bearer 口令进入）。
# ACCESS_ALLOWED_EMAILS=

# 可选：公开 API 跨域白名单（逗号分隔完整 origin，留空 = 仅同源）
# ALLOWED_ORIGINS=

# 建议配置：GitHub Token。提高 API 速率限额（匿名共享出口只有 60 次/小时），也让私有仓库可同步。
# 「预览图按目录批量导入」没有它时只能用匿名配额，很容易 429；管理端同步栏里临时填的 token 也可以顶替。
# GITHUB_TOKEN=
